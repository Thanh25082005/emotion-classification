APP_ENV=development

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/emotion_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=emotion_db

JWT_SECRET=change_me_in_production_use_strong_random_secret_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

AI_SERVICE_BASE_URL=http://localhost:9000
AI_SERVICE_TIMEOUT_SECONDS=10

REDIS_URL=redis://localhost:6379/0
