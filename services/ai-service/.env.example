APP_NAME=ai-service
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=9000
LOG_LEVEL=INFO

# Absolute paths to model weight files
# For local dev: weights live at services/ai-service/weights/
YOLO_MODEL_PATH=/path/to/emotion-classification/services/ai-service/weights/best.pt
EMOTION_MODEL_PATH=/path/to/emotion-classification/services/ai-service/weights/efficientnet_b2_fer2013.pth

# Detection confidence threshold (0.0 - 1.0)
YOLO_CONF_THRESHOLD=0.5

# Compute device: auto, cuda, cpu
DEVICE=auto
